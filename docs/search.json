---
layout: null
---
{%- comment -%}
The search index of the documentation site, read by the search box in _layouts/default.html:
one entry per page of the sidebar (_data/nav.yml) and one per h2 section of it, with the text
stripped of Markdown and HTML.
Only filters of Jekyll 3.10 / Liquid 4, as GitHub Pages builds it (tests/test_tooling.py checks).
{%- endcomment -%}
[
{%- assign sep = "" -%}
{%- for group in site.data.nav -%}
{%- for item in group.pages -%}
{%- assign found = site.pages | where: "path", item.url -%}
{%- for p in found limit: 1 -%}
{%- if item.url == "README.md" -%}{%- assign href = "/" | relative_url -%}{%- else -%}{%- assign href = item.url | replace: ".md", ".html" | relative_url -%}{%- endif -%}
{%- assign html = p.content | markdownify -%}
{%- assign parts = html | split: '<h2 id="' -%}
{%- assign text = parts | first | strip_html | truncate: 8000, "" -%}
{{ sep }}
{"title": {{ item.title | jsonify }}, "section": {{ group.title | jsonify }}, "url": {{ href | jsonify }}, "text": {{ text | jsonify }}}
{%- assign sep = "," -%}
{%- comment -%}One more entry per h2 section, linking to its anchor: the page entry above has only the text before the first one.{%- endcomment -%}
{%- for part in parts offset: 1 -%}
{%- assign sid = part | split: '"' | first -%}
{%- assign head = part | split: '</h2>' | first -%}
{%- assign stitle = head | remove_first: sid | remove_first: '">' | strip_html | strip -%}
{%- assign stext = part | remove_first: head | strip_html | truncate: 4000, "" -%}
,
{"title": {{ stitle | jsonify }}, "page": {{ item.title | jsonify }}, "section": {{ group.title | jsonify }}, "url": {{ href | append: "#" | append: sid | jsonify }}, "text": {{ stext | jsonify }}}
{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{%- endfor %}
]
